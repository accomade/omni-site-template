{
  "name": "omni-site-template",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "cd fonts-generator && ./fonts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/arizonia": "^5.3.0",
    "@fontsource/carrois-gothic": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@twicpics/components": "^0.33.0",
    "accomadesc": "^0.4.34",
    "gdpr-cooco-banner": "^0.0.13",
    "js-cookie": "^3.0.8"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
