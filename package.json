{
  "name": "omni-site-template",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "cd fonts-generator && ./fonts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/js-cookie": "^3.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/squirrelly": "^8.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/arizonia": "^5.3.0",
    "@fontsource/carrois-gothic": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@twicpics/components": "^0.33.0",
    "accomadesc": "^0.4.32",
    "gdpr-cooco-banner": "^0.0.13",
    "js-cookie": "^3.0.8",
    "luxon": "^3.7.2"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
